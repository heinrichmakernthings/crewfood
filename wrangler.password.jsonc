{
  // Crew Table WITH the password gate (src/worker.js). Deploy with: npx wrangler deploy -c wrangler.password.jsonc
  "name": "crewfood",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
